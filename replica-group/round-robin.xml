<?xml version="1.0" encoding="UTF-8" ?>
<icegrid>
   <application name="App">
      <replica-group id="ToolGroup">
         <load-balancing type="round-robin"/>
      </replica-group>
      <node name="node1">
         <server id="ToolServer1" activation="always" user="ice" exe="/app/server.py">
            <properties>
               <property name="Ice.StdOut" value=""/>
               <property name="Ice.StdErr" value=""/>
            </properties>
            <adapter name="ToolAdapter" replica-group="ToolGroup"/>
         </server>
      </node>
      <node name="node2">
         <server id="ToolServer2" activation="always" user="ice" exe="/app/server.py">
            <properties>
               <property name="Ice.StdOut" value=""/>
               <property name="Ice.StdErr" value=""/>
            </properties>
            <adapter name="ToolAdapter" replica-group="ToolGroup"/>
         </server>
      </node>
   </application>
</icegrid>
